#!/usr/bin/env bash
# Vor jedem Commit (STB-3): Fassung hochzählen und die Prüfungen des Appkerns, darunter die harten Architekturregeln
# aus architektur/regeln.toml. Befunde halten den Commit auf; Ausnahmen nur mit Freigabe des Nutzers am Ticket.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python="${APPKERN_PYTHON:-$HOME/Entwicklung/Werkzeuge/Appkern/.venv/bin/python}"
if [ ! -x "$python" ]; then
  echo "Abbruch: keine Python-Umgebung mit dem Appkern gefunden (APPKERN_PYTHON)" >&2
  exit 1
fi
exec "$python" -m appkern.werkzeuge vor-dem-commit
