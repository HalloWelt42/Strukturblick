{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bestellungen an den Lieferdienst (erfunden, zum Üben)",
  "description": "Was der erfundene Lieferdienst des Hofladens Lindenhof annimmt. Er liefert höchstens drei Positionen je Bestellung.",
  "type": "object",
  "required": ["shop", "stand", "bestellungen"],
  "properties": {
    "shop": { "type": "string", "minLength": 1 },
    "stand": { "type": "string", "format": "date-time" },
    "bestellungen": { "type": "array", "items": { "$ref": "#/$defs/Bestellung" } }
  },
  "$defs": {
    "Bestellung": {
      "type": "object",
      "required": ["nr", "datum", "kunde", "positionen", "bezahlt"],
      "additionalProperties": false,
      "properties": {
        "nr": { "type": "string", "pattern": "^B-[0-9]{5}$" },
        "datum": { "type": "string", "format": "date" },
        "kunde": { "$ref": "#/$defs/Kunde" },
        "positionen": { "type": "array", "minItems": 1, "maxItems": 3, "description": "Der Lieferdienst nimmt höchstens drei Positionen je Bestellung an.", "items": { "$ref": "#/$defs/Position" } },
        "bezahlt": { "type": "boolean" },
        "notiz": { "type": ["string", "null"] }
      }
    },
    "Kunde": {
      "type": "object",
      "required": ["name", "plz", "stadt"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "plz": { "type": "string", "pattern": "^[0-9]{5}$" },
        "stadt": { "type": "string" }
      }
    },
    "Position": {
      "type": "object",
      "required": ["artikel", "menge", "preis"],
      "properties": {
        "artikel": { "type": "string" },
        "menge": { "type": "integer", "minimum": 1 },
        "preis": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
