{
  "name": "strukturblick",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_BAUART=server vite",
    "build": "VITE_BAUART=server vite build && node node_modules/appkern-oberflaeche/oberflaeche/werkzeuge/symbol-einbetten.mjs dist",
    "build:eigenstaendig": "VITE_BAUART=eigenstaendig vite build --outDir dist-eigenstaendig && cp dist-eigenstaendig/index.html dist-eigenstaendig/404.html",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:leistung": "STRUKTURBLICK_LEISTUNG=1 vitest run --no-file-parallelism -t \"Leistung: \"",
    "dev:eigenstaendig": "VITE_BAUART=eigenstaendig vite"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lezer/highlight": "^1.2.5",
    "appkern-oberflaeche": "github:HalloWelt42/appkern",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "jsonpath-plus": "^11.3.0",
